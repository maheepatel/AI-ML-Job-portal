# All optional — defaults run locally with SQLite. Prefix: GRADIENT_
# Postgres in production, e.g. postgresql+psycopg://user:pass@host:5432/gradient
GRADIENT_DATABASE_URL=
GRADIENT_SCRAPE_INTERVAL_HOURS=4
GRADIENT_RUN_ON_START=false
GRADIENT_ENABLE_LINKEDIN=true
GRADIENT_MAX_CONCURRENCY=24
GRADIENT_CORS_ORIGINS=["http://localhost:5270"]
